# ---- backend ----
NODE_ENV=development
PORT=8080
# Must be a replica set (multi-document transactions). Atlas works out of the box.
MONGODB_URI=mongodb://localhost:27017/refunddesk?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-32-plus-random-bytes-xxxxxxxx
JWT_TTL_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOGIN_RATE_LIMIT_PER_MIN=5
# true = API process also runs the agent worker (handy locally); false = run `npm run worker` separately
RUN_WORKER_INLINE=true
# LLM: groq | gemini | ollama | mock  (mock = deterministic offline investigator for demos)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_CALLS_PER_CASE=3

# ---- frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
